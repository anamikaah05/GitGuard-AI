# ─────────────────────────────────────────────
# GitGuard AI — Environment Configuration
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# GitHub Personal Access Token (for fetching PR diffs via GitHub API)
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_personal_access_token_here

# Absolute or relative paths to the trained model .pkl files
# (relative paths are resolved from the backend/ directory)
SECRET_MODEL_PATH=../ml/saved_models/prowlbench_logistic_model.pkl
TFIDF_VECTORIZER_PATH=../ml/saved_models/prowlbench_tfidf_vectorizer.pkl
PR_RISK_MODEL_PATH=../ml/saved_models/sevra_improved_random_forest.pkl

# CORS: comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# App settings
APP_ENV=development
LOG_LEVEL=info
# GitHub webhook and GitHub App
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY_PATH=path_to_private_key_file
GITHUB_APP_INSTALLATION_ID=your_installation_id_here
